<style>
  .footer {
    background: #f5f3f0;
    border-top: 1px solid #e0ddd9;
    margin-top: 8rem;
  }

  .footer-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem 2rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
  }

  .footer-section h3 {
    font-family: 'Georgia', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 1.5rem;
    letter-spacing: 0.05em;
  }

  .about-section p {
    font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
  }

  .links-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .links-section li {
    margin-bottom: 1rem;
  }

  .links-section a {
    font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    font-size: 0.95rem;
    color: #666;
    text-decoration: none;
    transition: color 0.3s ease;
    letter-spacing: 0.02em;
  }

  .links-section a:hover {
    color: #1a1a1a;
  }

  .contact-info {
    font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
  }

  .contact-info p {
    margin: 0.5rem 0;
  }

  .contact-info a {
    color: #666;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .contact-info a:hover {
    color: #1a1a1a;
  }

  .footer-bottom {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid #e0ddd9;
    font-family: 'Segoe UI', 'Helvetica Neue', sans-serif;
    font-size: 0.85rem;
    color: #999;
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding: 2.5rem 1.5rem;
    }

    .footer-section h3 {
      font-size: 1rem;
    }

    .footer-bottom {
      font-size: 0.8rem;
      padding: 1.5rem;
    }
  }
</style>
